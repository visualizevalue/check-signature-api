{
  "typescript": true,
  "exceptionHandlerNamespace": "App/Exceptions/Handler",
  "aliases": {
    "App": "app",
    "Config": "config",
    "Database": "database",
    "Contracts": "contracts"
  },
  "preloads": [
    "./start/routes.js",
    "./start/kernel.js",
    {
      "file": "./start/validator.js",
      "environment": [
        "web"
      ]
    }
  ],
  "providers": [
    "./providers/AppProvider.js",
    "@adonisjs/core",
    "@adonisjs/lucid"
  ],
  "aceProviders": [
    "@adonisjs/repl"
  ],
  "tests": {
    "suites": [
      {
        "name": "functional",
        "files": [
          "tests/functional/**/*.spec(.ts|.js)"
        ],
        "timeout": 60000
      }
    ]
  },
  "testProviders": [
    "@japa/preset-adonis/TestsProvider"
  ]
}